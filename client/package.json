{
  "name": "echo-client",
  "productName": "Echo",
  "version": "1.2.1",
  "private": true,
  "description": "Echo вЂ” РіРѕР»РѕСЃРѕРІРѕР№ С‡Р°С‚ РґР»СЏ СЃРІРѕРёС…",
  "author": "octodaniil",
  "homepage": "https://github.com/octodaniil/echo",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron-updater": "^6.8.11",
    "livekit-client": "^2.24.1",
    "onnxruntime-web": "^1.31.1",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "io.github.octodaniil.echo",
    "productName": "Echo",
    "copyright": "octodaniil",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Echo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Echo-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "octodaniil",
      "repo": "echo",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
