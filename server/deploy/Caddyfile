{
	# Port 443 is taken by another service on this host, so HTTPS lives on 8443.
	# Certificates are obtained via the HTTP-01 challenge on port 80.
	https_port 8443
}

{$ECHO_DOMAIN}:8443 {
	# `handle` blocks are mutually exclusive and the most specific path wins.
	# (Bare `respond` would run before `reverse_proxy` and swallow everything.)

	# Webhooks are only for LiveKit on localhost, never from the internet.
	handle /api/livekit/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# LiveKit signaling (WebSocket).
	handle /rtc* {
		reverse_proxy 127.0.0.1:7880
	}

	handle {
		respond "Echo server" 200
	}
}
