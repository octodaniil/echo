# Public domain of the server (without port).
ECHO_DOMAIN=echo-voice.duckdns.org

# DuckDNS: subdomain (without .duckdns.org) and your token from duckdns.org.
DUCKDNS_SUBDOMAIN=echo-voice
DUCKDNS_TOKEN=

# LiveKit credentials. The key name must match webhook.api_key in livekit.yaml.
# install.sh generates the secret automatically.
LIVEKIT_API_KEY=echo
LIVEKIT_API_SECRET=
